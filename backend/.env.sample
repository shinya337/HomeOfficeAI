# Google Cloud Project ID (Vertex AI Gemini APIに必要)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI設定（オプション）
VERTEX_AI_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK（ADC使用のため追加設定は基本不要）
# ローカル開発: gcloud auth application-default login を実行
# GOOGLE_CLOUD_PROJECT は上記で設定済み

# クレデンシャル暗号化キー（AES-256-GCM、Base64エンコードされた32バイトキー）
# 生成コマンド: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nature RemoトークンやAlexaクッキーのFirestore暗号化保存に使用
CREDENTIAL_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
