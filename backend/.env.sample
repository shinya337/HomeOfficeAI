# Google Cloud Project ID (Vertex AI Gemini APIに必要)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI設定（オプション）
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Nature Remo API Token (IoTデバイス制御に必要)
# https://home.nature.global/ から取得
NATURE_REMO_TOKEN=your-nature-remo-token

# Alexa Remote2 - Cookie認証設定
# Cookie保存パス (default: ./.alexa-cookie.json)
ALEXA_COOKIE_FILE_PATH=./.alexa-cookie.json
# 認証プロキシのポート (default: 3456, APIサーバーの3001と別ポートを使用)
ALEXA_PROXY_PORT=3456
